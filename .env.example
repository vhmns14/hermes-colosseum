# Hermes Colosseum - Configuration Template
# Copy to .env: cp .env.example .env

# LLM Provider: 'mock' (zero-cost offline heuristic/simulator), 'openai', or 'agentrouter'
LLM_PROVIDER=mock

# Base URL for OpenAI-compatible endpoints (e.g. OpenCode agentrouter-proxy or Ollama)
OPENAI_BASE_URL=http://localhost:8787/v1
OPENAI_API_KEY=your_api_key_here
DEFAULT_MODEL=gpt-4o-mini

# Match simulation parameters
PLAYERS_COUNT=5
GAME_SPEED=normal
